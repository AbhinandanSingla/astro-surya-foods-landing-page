---
import MasterLayout from "../layouts/MasterLayout.astro";
import LeadForm from "../components/LeadForm.astro";
import { BRAND_48_PRODUCTS } from "../consts/brand48";

const products = BRAND_48_PRODUCTS;

const markets = ["Punjab", "Haryana", "Delhi NCR", "Rajasthan", "Uttar Pradesh", "Gujarat", "Maharashtra", "Madhya Pradesh", "Karnataka", "Telangana", "Tamil Nadu", "West Bengal"];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "48 Basmati Rice Range",
  itemListElement: products.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Product",
      name: `48 ${product.name} ${product.subtext}`,
      description: product.description,
      image: `https://suryafoodspatran.com${product.image}`,
      brand: { "@type": "Brand", name: "48 by Surya Foods" },
      category: "Basmati Rice",
      countryOfOrigin: { "@type": "Country", name: "India" },
    },
  })),
};
---

<MasterLayout
  title="48 Basmati Rice Brand | Wholesale & Distribution — Surya Foods"
  description="Explore the 48 Basmati rice range — five trusted variants for wholesale mandis, distributors, retail and institutional buyers across India. Gold, Silver, Diamond, Crystal and Mini Gold."
  keywords="48 basmati rice, wholesale basmati rice India, mandi rice brand, rice distributor India, bulk basmati rice, 48 gold rice, 48 silver rice, 48 diamond rice, surya foods rice brand, rice wholesale Punjab"
  image="/images/Rice Bags/Old Rice Bags/48-Gold.jpg"
  transparentNav={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative min-h-[88vh] overflow-hidden bg-forest-950 flex items-center">
    <img src="/images/48-hero-bg.jpg" alt="Indian rice paddy fields at golden hour" class="absolute inset-0 w-full h-full object-cover" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-forest-950/95 via-forest-950/70 to-forest-950/35"></div>
    <div class="absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-gold-400/10 blur-3xl"></div>
    <div class="absolute left-1/3 top-1/4 h-56 w-56 rounded-full bg-48-orange/10 blur-3xl"></div>
    <div class="relative z-10 container-custom w-full pt-36 pb-20 md:pt-44 md:pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 xl:col-span-5">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-gold-300 mb-5">Market-Trusted Basmati Rice Brand</p>
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-heading font-bold text-white leading-[0.98] mb-6">
            Trusted name.<br /><span class="text-gradient-gold">Five proven choices.</span>
          </h1>
          <p class="text-lg md:text-xl text-forest-100/85 leading-relaxed max-w-xl mb-8">48 is Surya Foods' heritage Basmati rice brand — a name recognised in mandis and markets across North India for consistent quality and trade-friendly positioning.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#our-range" class="btn-gold">Explore the range</a>
            <a href="#brand-inquiry" class="btn-secondary">Become a distributor</a>
          </div>
          <div class="mt-10 pt-6 border-t border-white/10 flex flex-wrap gap-x-8 gap-y-3 text-[11px] font-semibold uppercase tracking-widest text-forest-200/70">
            <span>Made in India</span><span>Wholesale & Retail</span><span>Pan-India Distribution</span>
          </div>
        </div>
        <div class="lg:col-span-6 xl:col-span-7 relative min-h-[420px] md:min-h-[540px]" aria-label="48 Basmati rice packaging">
          <div class="absolute left-[2%] top-[16%] w-[47%] rotate-[-5deg] overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
            <img src="/images/Rice Bags/Old Rice Bags/48-Gold.jpg" alt="48 Gold Premium Basmati Rice bag" class="w-full" loading="eager" decoding="async" />
          </div>
          <div class="absolute right-[1%] top-0 w-[57%] rotate-[3deg] overflow-hidden rounded-3xl border border-gold-300/20 shadow-2xl">
            <img src="/images/Rice Bags/Old Rice Bags/48-Silver.jpg" alt="48 Silver Select Basmati Rice bag" class="w-full" loading="eager" decoding="async" />
          </div>
          <div class="absolute right-[4%] bottom-[2%] rounded-2xl border border-gold-300/25 bg-forest-950/85 backdrop-blur-md px-5 py-4 shadow-xl">
            <p class="text-[10px] uppercase tracking-[0.22em] text-gold-300 mb-1">The 48 legacy</p>
            <p class="font-heading text-lg font-semibold text-white">Trusted for generations</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ BRAND INTRO ═══════════════════ -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5" data-animate>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">Meet 48</p>
          <h2 class="text-3xl md:text-5xl font-heading font-bold text-slate-900 leading-tight mb-5">A heritage brand built on trust and taste.</h2>
          <div class="gold-line"></div>
        </div>
        <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6" data-animate>
          <p class="text-base text-slate-600 leading-relaxed sm:col-span-2">48 is Surya Foods' original market brand, built over years of consistent supply to wholesale mandis, retail shops and institutional buyers. Each bag carries the iconic <strong class="text-slate-800">"48"</strong> mark with ornate flourishes — a symbol of quality that traders and families recognise instantly.</p>
          {[
            { title: "Built for Indian markets", text: "A proven brand for wholesale mandis, kirana stores, supermarkets and institutional buyers across North India and beyond." },
            { title: "Five trusted variants", text: "Gold, Silver, Diamond, Crystal and Mini Gold — a complete range from premium to everyday, covering every buyer segment." },
          ].map((item) => (
            <div class="rounded-2xl bg-cream p-6 border border-gold-100">
              <h3 class="text-xl font-heading font-bold text-forest-900 mb-2">{item.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PRODUCT RANGE ═══════════════════ -->
  <section id="our-range" class="section-padding scroll-mt-28 bg-cream">
    <div class="container-custom">
      <div class="max-w-3xl mb-12 md:mb-16" data-animate>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">The 48 Collection</p>
        <h2 class="text-3xl md:text-5xl font-heading font-bold text-slate-900 mb-5">Five variants. One trusted name.</h2>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed">From flagship Gold to everyday Mini Gold, every 48 bag delivers the Basmati quality that Indian markets have trusted for years.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {products.map((product, index) => (
          <a href={`/48-brand/${product.slug}`} class="group block bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 no-underline" data-animate>
            <div class="relative aspect-square overflow-hidden">
              <img src={product.image} alt={`48 ${product.name} ${product.subtext} rice bag`} class="w-full h-full object-cover group-hover:scale-[1.035] transition-transform duration-700" loading="lazy" decoding="async" />
              <div class={`absolute left-4 top-4 ${product.colorClass} text-white text-[10px] uppercase tracking-[0.16em] font-bold px-3 py-2 rounded-full shadow-lg`}>{String(index + 1).padStart(2, "0")} · {product.color}</div>
            </div>
            <div class="p-6 md:p-7">
              <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-gold-500 mb-2">48 Basmati Rice</p>
              <h3 class="text-2xl font-heading font-bold text-slate-900 mb-1">{product.name}</h3>
              <p class="text-xs font-semibold uppercase tracking-wider text-forest-700 mb-4">{product.subtext}</p>
              <p class="text-sm text-slate-600 leading-relaxed">{product.description}</p>
              <span class="inline-flex mt-5 text-sm font-bold text-forest-700 group-hover:text-gold-600 transition-colors">View product details →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ GRAIN QUALITY SHOWCASE ═══════════════════ -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div data-animate>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">Real Rice Quality</p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-5">Quality that markets trust, year after year.</h2>
          <p class="text-slate-600 leading-relaxed mb-6">Every 48 variant is processed at Surya Foods' facility in Punjab, using carefully selected Basmati paddy from India's finest rice-growing regions. Multi-pass sortex technology and batch-by-batch quality checks ensure the consistency that buyers depend on.</p>
          <div class="space-y-3 mb-8">
            {[
              "Carefully selected Basmati paddy from premium growing regions",
              "Multi-pass colour sorting for consistent grain appearance",
              "In-house lab testing for moisture, aroma and purity",
              "Hygienically packed at our modern facility in Punjab",
            ].map((point) => (
              <div class="flex items-center gap-3 text-sm text-slate-700">
                <span class="h-2 w-2 rounded-full bg-forest-500"></span>{point}
              </div>
            ))}
          </div>
          <a href="#our-range" class="text-sm font-semibold text-forest-700 hover:text-gold-600 no-underline transition-colors">Explore all five variants →</a>
        </div>
        <div class="grid grid-cols-2 gap-3 md:gap-4" data-animate>
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-lg col-span-2">
            <img src="/images/rice-images/TIBAR.jpeg" alt="Premium Basmati rice grains close-up" class="w-full h-48 md:h-64 object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-lg">
            <img src="/images/rice-images/Second wand.jpeg" alt="Basmati rice grain quality" class="w-full h-40 md:h-48 object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-lg">
            <img src="/images/rice-images/1401-steam-rice-1.png" alt="Long grain Basmati rice" class="w-full h-40 md:h-48 object-cover" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ BRAND HERITAGE ═══════════════════ -->
  <section class="section-padding bg-cream">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12" data-animate>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">A Legacy of Quality</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">The original rice bags that built our reputation.</h2>
        <p class="text-slate-600">These are the actual 48 bags that have been sold across mandis and markets. Each colour and name carries its own recognition and loyal buyer base.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5">
        {[
          { src: "/images/Rice Bags/Old Rice Bags/Gold.jpeg", alt: "48 Gold Basmati Rice original bag", name: "Gold" },
          { src: "/images/Rice Bags/Old Rice Bags/Silver.jpeg", alt: "48 Silver Basmati Rice original bag", name: "Silver" },
          { src: "/images/Rice Bags/Old Rice Bags/Diamond.jpeg", alt: "48 Diamond Basmati Rice original bag", name: "Diamond" },
          { src: "/images/Rice Bags/Old Rice Bags/Crystal.JPG", alt: "48 Crystal Basmati Rice original bag", name: "Crystal" },
          { src: "/images/Rice Bags/Old Rice Bags/MiniGold.jpeg", alt: "48 Mini Gold Basmati Rice original bag", name: "Mini Gold" },
        ].map((bag) => (
          <figure class="rounded-2xl overflow-hidden border border-slate-200 shadow-lg group" data-animate>
            <div class="overflow-hidden">
              <img src={bag.src} alt={bag.alt} class="w-full aspect-[3/4] object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
            </div>
            <figcaption class="p-3 text-center bg-white border-t border-slate-100">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-700">48 {bag.name}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PARTNER VALUE ═══════════════════ -->
  <section class="section-padding bg-forest-950 text-white overflow-hidden">
    <div class="container-custom relative">
      <div class="absolute -right-24 -top-24 w-80 h-80 rounded-full bg-gold-400/10 blur-3xl"></div>
      <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div data-animate>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-300 mb-4">For Distributors & Wholesale Buyers</p>
          <h2 class="text-3xl md:text-5xl font-heading font-bold text-white leading-tight mb-6">A brand that sells itself on reputation.</h2>
          <p class="text-forest-100/75 leading-relaxed mb-8">48 doesn't need introduction in the markets where it's established. If you're looking to distribute a proven Basmati rice brand with existing market recognition, five variants covering every buyer segment, and the backing of Surya Foods' processing infrastructure — let's talk.</p>
          <a href="#brand-inquiry" class="btn-gold">Partner with us</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-4" data-animate>
          {[
            { number: "01", title: "Market-proven name", text: "Years of consistent supply have built the 48 name across North Indian mandis and wholesale channels." },
            { number: "02", title: "Five-variant portfolio", text: "From flagship Gold to everyday Mini Gold — a complete range to stock every segment." },
            { number: "03", title: "Competitive positioning", text: "Aggressive pricing and bulk-friendly pack sizes for wholesale, mandi and institutional channels." },
            { number: "04", title: "Surya Foods quality", text: "Processed at our own facility in Punjab with full quality controls and supply reliability." },
          ].map((item) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
              <p class="text-xs font-bold tracking-widest text-gold-300 mb-5">{item.number}</p>
              <h3 class="text-xl font-heading font-bold text-white mb-2">{item.title}</h3>
              <p class="text-sm text-forest-100/65 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ TARGET MARKETS ═══════════════════ -->
  <section class="section-padding bg-slate-50">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-2" data-animate>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">Distribution Across India</p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-5">Growing the 48 network, state by state.</h2>
          <p class="text-slate-600 leading-relaxed">We welcome distribution, wholesale and retail partnerships for the 48 range across India. Whether you operate a mandi, wholesale counter, kirana network, supermarket chain or institutional supply business — reach out to discuss territories and terms.</p>
        </div>
        <div class="lg:col-span-3 flex flex-wrap gap-3" data-animate>
          {markets.map((market) => (
            <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm"><span class="w-1.5 h-1.5 rounded-full bg-gold-400 mr-2.5"></span>{market}</span>
          ))}
          <p class="w-full mt-3 text-xs text-slate-500">Market names indicate distribution interest. We welcome enquiries from all states and territories.</p>
        </div>
      </div>
    </div>
  </section>

  <LeadForm
    formId="brand-inquiry"
    formType="brand"
    heading="Become a 48 Distribution Partner"
    subtitle="Share your location, business type and expected volume. Our team will respond with the 48 catalogue and discuss distribution terms for your territory."
  />
</MasterLayout>
