---
import { PHONE_NUMBER, WHATSAPP_NUMBER, EMAIL } from "../consts";
---

<!-- Floating Contact Sidebar — Desktop: left side, Mobile: bottom bar -->
<div class="fixed left-0 top-1/2 -translate-y-1/2 z-40 hidden md:flex flex-col gap-2" id="floating-contact">
  <!-- WhatsApp -->
  <a
    href={`https://wa.me/${WHATSAPP_NUMBER}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative flex items-center justify-center w-12 h-12 bg-green-500 text-white rounded-r-xl shadow-lg hover:w-auto hover:px-4 hover:gap-2 transition-all duration-300 no-underline"
    aria-label="Chat on WhatsApp"
  >
    <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    <span class="hidden group-hover:inline text-xs font-semibold whitespace-nowrap">WhatsApp</span>
  </a>

  <!-- Send Inquiry -->
  <a
    href="/contact"
    class="group relative flex items-center justify-center w-12 h-12 bg-gold-500 text-white rounded-r-xl shadow-lg hover:w-auto hover:px-4 hover:gap-2 transition-all duration-300 no-underline"
    aria-label="Send an inquiry"
  >
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
    <span class="hidden group-hover:inline text-xs font-semibold whitespace-nowrap">Inquiry</span>
  </a>

  <!-- Call -->
  <a
    href={`tel:${PHONE_NUMBER}`}
    class="group relative flex items-center justify-center w-12 h-12 bg-blue-500 text-white rounded-r-xl shadow-lg hover:w-auto hover:px-4 hover:gap-2 transition-all duration-300 no-underline"
    aria-label="Call us"
  >
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
    <span class="hidden group-hover:inline text-xs font-semibold whitespace-nowrap">Call</span>
  </a>

  <!-- Location -->
  <a
    href="#map-section"
    class="group relative flex items-center justify-center w-12 h-12 bg-red-500 text-white rounded-r-xl shadow-lg hover:w-auto hover:px-4 hover:gap-2 transition-all duration-300 no-underline"
    aria-label="View location"
  >
    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
    <span class="hidden group-hover:inline text-xs font-semibold whitespace-nowrap">Location</span>
  </a>
</div>

<!-- Mobile: Bottom fixed bar -->
<div class="fixed bottom-0 left-0 right-0 z-40 md:hidden bg-forest-950/95 backdrop-blur-md border-t border-forest-700/30 shadow-2xl">
  <div class="grid grid-cols-4 divide-x divide-forest-700/30">
    <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-1 py-2.5 text-green-400 hover:text-green-300 transition-colors no-underline">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span class="text-[9px] font-semibold uppercase tracking-wider">WhatsApp</span>
    </a>
    <a href="/contact" class="flex flex-col items-center gap-1 py-2.5 text-gold-400 hover:text-gold-300 transition-colors no-underline">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      <span class="text-[9px] font-semibold uppercase tracking-wider">Inquiry</span>
    </a>
    <a href={`tel:${PHONE_NUMBER}`} class="flex flex-col items-center gap-1 py-2.5 text-blue-400 hover:text-blue-300 transition-colors no-underline">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
      <span class="text-[9px] font-semibold uppercase tracking-wider">Call</span>
    </a>
    <a href="#map-section" class="flex flex-col items-center gap-1 py-2.5 text-red-400 hover:text-red-300 transition-colors no-underline">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      <span class="text-[9px] font-semibold uppercase tracking-wider">Location</span>
    </a>
  </div>
</div>
