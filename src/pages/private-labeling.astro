---
import MasterLayout from "../layouts/MasterLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import LeadForm from "../components/LeadForm.astro";
import { CERTIFICATIONS_DISPLAY } from "../consts";

const benefits = [
  {
    title: "Exclusive Brand Identity",
    description: "Launch your own line of premium Basmati and Non-Basmati rice, tailored exactly to your brand's vision and target demographic.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`
  },
  {
    title: "Customer Trust & Loyalty",
    description: "Deliver a consistently superior product that guarantees repeat purchases. We maintain the quality so you can focus on scaling your brand.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
  },
  {
    title: "Higher Profit Margins",
    description: "By partnering directly with the mill, you cut out intermediaries. Set your own pricing strategy and maximize your profitability.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  {
    title: "Market Differentiation",
    description: "Stand out on the shelves with bespoke packaging and a product that reflects your brand's unique values and high standards.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  }
];

const packagingOptions = [
  {
    category: "1–5 kg (Retail & Premium Packs)",
    description: "Designed for high shelf-appeal in supermarkets and retail stores.",
    materials: [
      { name: "LDPE Pouches", details: "Moisture-proof, zipper or vacuum options." },
      { name: "BOPP Laminated Bags", details: "Premium look, high-definition printing." }
    ]
  },
  {
    category: "5–25 kg (Semi-Bulk Packs)",
    description: "Ideal for premium retail, wholesale, and export markets.",
    materials: [
      { name: "BOPP Bags", details: "Strong shelf appeal with robust durability." },
      { name: "Non-Woven Bags", details: "Lightweight, customizable, and eco-friendly." }
    ]
  },
  {
    category: "25–50 kg (Wholesale Packs)",
    description: "Heavy-duty packaging for catering, HORECA, and bulk distribution.",
    materials: [
      { name: "PP Woven Bags", details: "Tear-resistant and cost-effective." },
      { name: "Jute Bags", details: "100% natural and biodegradable for premium eco-branding." }
    ]
  }
];
---

<MasterLayout
  title="Private Labeling | Surya Foods"
  description="Build your own premium rice brand with Surya Foods. We offer end-to-end private labeling solutions from sourcing and processing to custom packaging."
  transparentNav={true}
>
  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative min-h-[70vh] flex items-center pt-24">
    <!-- Background Image -->
    <img
      src="/images/gallery/packaging-1.jpg"
      alt="Rice packaging line"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-forest-950/95 via-forest-950/80 to-forest-950/40"></div>

    <div class="relative z-10 container-custom py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-gold-400 mb-4 animate-fade-in">
          END-TO-END SOLUTIONS
        </p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-bold text-white leading-[1.1] mb-6">
          Your Brand.<br />
          <span class="text-gradient-gold">Our Premium Rice.</span>
        </h1>
        <p class="text-base md:text-lg text-forest-100/90 leading-relaxed mb-8 max-w-xl">
          Empower your business with a powerful market presence. Surya Foods offers comprehensive private labeling services—delivering world-class Basmati and Non-Basmati rice seamlessly packaged under your brand name.
        </p>
        <a href="#inquiry-form" class="btn-primary">
          Start Your Brand Journey
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ WHY CHOOSE US ═══════════════════ -->
  <section class="section-padding bg-cream">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16" data-animate>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-3">Why Partner With Us</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-6">Built for Ambitious Brands</h2>
        <p class="text-slate-600 leading-relaxed">
          Your brand deserves the absolute best. When you partner with Surya Foods, you gain more than a supplier—you secure a dedicated partner committed to elevating your brand in competitive global markets.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {benefits.map((benefit) => (
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-xl hover:border-gold-200 transition-all duration-300 group" data-animate>
            <div class="w-12 h-12 rounded-xl bg-forest-50 flex items-center justify-center text-forest-600 mb-6 group-hover:bg-gold-500 group-hover:text-white transition-colors duration-300" set:html={benefit.icon} />
            <h3 class="text-lg font-heading font-bold text-slate-900 mb-3">{benefit.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ QUALITY COMMITMENT ═══════════════════ -->
  <section class="section-padding bg-white overflow-hidden">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Text -->
        <div data-animate>
          <SectionHeading
            overline="Uncompromising Standards"
            title="We Package Trust."
            subtitle="At Surya Foods, quality is our foundation. We don't just package rice; we package the reputation of your brand."
            align="left"
          />
          <div class="mt-6 space-y-5 text-slate-600 leading-relaxed">
            <p>
              We meticulously source the finest Basmati varieties and process them using cutting-edge sortex technology. Every single stage, from milling to packaging, undergoes rigorous quality checks to ensure absolute purity, consistency, and culinary excellence.
            </p>
            <p>
              Even our packaging materials are subjected to intense scrutiny to maintain freshness, enhance durability, and perfectly align with your brand identity.
            </p>
          </div>
          
          <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
            {CERTIFICATIONS_DISPLAY.slice(0, 4).map((cert) => (
              <div class="flex flex-col items-center gap-2 p-3 bg-cream rounded-lg border border-slate-100">
                <img src={cert.image} alt={cert.name} class="w-10 h-10 object-contain" />
                <span class="text-[10px] font-bold text-slate-700 uppercase">{cert.name}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Image -->
        <div class="relative" data-animate>
          <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl">
            <img
              src="/images/gallery/factory-2.jpg"
              alt="Quality control and processing"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Decorative element -->
          <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-gold-400/20 rounded-full blur-2xl -z-10"></div>
          <div class="absolute -top-6 -right-6 w-40 h-40 bg-forest-900/10 rounded-full blur-2xl -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PACKAGING OPTIONS ═══════════════════ -->
  <section class="section-padding bg-forest-900 relative">
    <!-- Subtle pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    
    <div class="relative container-custom">
      <div class="text-center max-w-2xl mx-auto mb-16" data-animate>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-400 mb-3">Customization</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">Flexible Packaging Options</h2>
        <p class="text-forest-200/80 leading-relaxed">
          We understand that every brand and target market is unique. That's why we offer a diverse range of packaging formats and premium materials tailored for retail, wholesale, and export.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {packagingOptions.map((pack) => (
          <div class="bg-forest-800/50 backdrop-blur-sm border border-forest-700/50 p-8 rounded-2xl hover:bg-forest-800 transition-colors duration-300" data-animate>
            <h3 class="text-xl font-heading font-bold text-gold-400 mb-3">{pack.category}</h3>
            <p class="text-sm text-forest-200/70 mb-6 pb-6 border-b border-forest-700/50">{pack.description}</p>
            
            <ul class="space-y-4">
              {pack.materials.map((mat) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-gold-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <div>
                    <span class="block text-sm font-semibold text-white">{mat.name}</span>
                    <span class="block text-xs text-forest-300 mt-1">{mat.details}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ LEAD FORM ═══════════════════ -->
  <section id="inquiry-form" class="section-padding bg-cream scroll-mt-20">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <!-- Form Info -->
        <div data-animate>
          <span class="inline-block py-1 px-3 rounded-full bg-gold-100 text-gold-700 text-xs font-bold uppercase tracking-wider mb-6">
            Let's Collaborate
          </span>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 leading-tight mb-6">
            Ready to Launch Your Private Label?
          </h2>
          <p class="text-slate-600 leading-relaxed mb-8">
            Tell us about your brand vision, target markets, and volume requirements. Our private labeling experts will get back to you within 24 hours with a comprehensive proposal and product samples.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-forest-100 flex items-center justify-center text-forest-700 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-900">Call our Experts</p>
                <p class="text-sm text-slate-600">+91-9779204835</p>
              </div>
            </div>
            
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-forest-100 flex items-center justify-center text-forest-700 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-900">Email Us</p>
                <p class="text-sm text-slate-600">contact@suryafoodspatran.com</p>
              </div>
            </div>
          </div>
        </div>

        <!-- The Form -->
        <div data-animate class="relative">
          <div class="absolute inset-0 bg-gold-400 rounded-2xl transform translate-x-3 translate-y-3 -z-10"></div>
          <LeadForm formType="export" />
        </div>
      </div>
    </div>
  </section>
</MasterLayout>
