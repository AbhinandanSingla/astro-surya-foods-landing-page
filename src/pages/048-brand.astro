---
import MasterLayout from "../layouts/MasterLayout.astro";
import LeadForm from "../components/LeadForm.astro";
import IndiaDistributionMap from "../components/IndiaDistributionMap.astro";
import { BRAND_048_PRODUCTS } from "../consts/brand048";

const products = BRAND_048_PRODUCTS;

const markets = ["United Arab Emirates", "Saudi Arabia", "Qatar", "Oman", "Kuwait", "Bahrain", "United Kingdom", "Canada", "Australia", "Singapore", "Malaysia", "Kenya", "South Africa", "India"];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "048 Premium Basmati Rice Range",
  itemListElement: products.map((product, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Product",
      name: `048 ${product.name} Premium ${product.subtext}`,
      description: product.description,
      image: `https://suryafoodspatran.com${product.image}`,
      brand: { "@type": "Brand", name: "048 by Surya Foods" },
      category: "Basmati Rice",
      countryOfOrigin: { "@type": "Country", name: "India" },
    },
  })),
};
---

<MasterLayout
  title="048 Premium Basmati Rice Brand | Exporters & Distributors — Surya Foods"
  description="Explore 048 premium Basmati rice from India: six retail-ready variants for global importers, rice distributors, wholesale buyers and Pan-India distribution partners."
  keywords="premium Basmati rice exporter India, Indian Basmati rice supplier, Basmati rice importer, rice distributor, wholesale rice supplier, private rice brand India, premium rice brand, long grain Basmati rice, extra long Basmati rice, 048 rice, bulk Basmati rice supplier, rice export from India, basmati rice for UAE, basmati rice distributor India"
  image="/images/Rice Bags/Tibar classic banner view image.jpeg"
  transparentNav={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative min-h-[88vh] overflow-hidden bg-forest-950 flex items-center">
    <img src="/images/048-hero-bg.jpg" alt="Premium Basmati rice grains with dramatic lighting" class="absolute inset-0 w-full h-full object-cover" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-forest-950/95 via-forest-950/75 to-forest-950/40"></div>
    <div class="absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-gold-400/10 blur-3xl"></div>
    <div class="relative z-10 container-custom w-full pt-36 pb-20 md:pt-44 md:pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 xl:col-span-5">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-gold-300 mb-5">Premium Indian Basmati Rice Brand</p>
          <h1 class="text-5xl sm:text-6xl md:text-7xl font-heading font-bold text-white leading-[0.98] mb-6">
            One brand.<br /><span class="text-gradient-gold">Six distinct choices.</span>
          </h1>
          <p class="text-lg md:text-xl text-forest-100/85 leading-relaxed max-w-xl mb-8">048 brings together a retail-ready range of premium Basmati rice for international importers, distributors, wholesale buyers and Indian trade partners.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#our-range" class="btn-gold">Explore the range</a>
            <a href="#brand-inquiry" class="btn-secondary">Request catalogue</a>
          </div>
          <div class="mt-10 pt-6 border-t border-white/10 flex flex-wrap gap-x-8 gap-y-3 text-[11px] font-semibold uppercase tracking-widest text-forest-200/70">
            <span>Made in India</span><span>Export Enquiries</span><span>Pan-India Distribution</span>
          </div>
        </div>
        <div class="lg:col-span-6 xl:col-span-7 relative min-h-[420px] md:min-h-[540px]" aria-label="048 premium Basmati rice packaging">
          <div class="absolute left-[2%] top-[16%] w-[47%] rotate-[-5deg] overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
            <img src="/images/Rice Bags/Signature XXL.jpeg" alt="048 Signature XXL Premium Long Grain Basmati Rice bag" class="w-full" loading="eager" decoding="async" />
          </div>
          <div class="absolute right-[1%] top-0 w-[57%] rotate-[3deg] overflow-hidden rounded-3xl border border-gold-300/20 shadow-2xl">
            <img src="/images/Rice Bags/XXXL Supreme.jpeg" alt="048 XXXL Supreme Premium Extra Long Basmati Rice bag" class="w-full" loading="eager" decoding="async" />
          </div>
          <div class="absolute right-[4%] bottom-[2%] rounded-2xl border border-gold-300/25 bg-forest-950/85 backdrop-blur-md px-5 py-4 shadow-xl">
            <p class="text-[10px] uppercase tracking-[0.22em] text-gold-300 mb-1">The 048 promise</p>
            <p class="font-heading text-lg font-semibold text-white">Premium quality in every pack</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ BRAND INTRO ═══════════════════ -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5" data-animate>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">Meet 048</p>
          <h2 class="text-3xl md:text-5xl font-heading font-bold text-slate-900 leading-tight mb-5">Premium Basmati for every market and meal.</h2>
          <div class="gold-line"></div>
        </div>
        <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6" data-animate>
          <p class="text-base text-slate-600 leading-relaxed sm:col-span-2">048 is Surya Foods' own Basmati rice brand from India, built to give trade partners a clear portfolio across premium, everyday, traditional and convenient cooking segments. Every bag carries the word <strong class="text-slate-800">Premium</strong> and a distinctive color identity for quick shelf recognition.</p>
          {[
            { title: "Built for global trade", text: "A focused Indian rice brand for importers, regional distributors, supermarkets, wholesalers and HoReCa buyers." },
            { title: "Ready for India", text: "A six-variant portfolio for state distributors, modern trade, general trade and institutional buyers across India." },
          ].map((item) => (
            <div class="rounded-2xl bg-cream p-6 border border-gold-100">
              <h3 class="text-xl font-heading font-bold text-forest-900 mb-2">{item.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PRODUCT RANGE ═══════════════════ -->
  <section id="our-range" class="section-padding scroll-mt-28 bg-cream">
    <div class="container-custom">
      <div class="max-w-3xl mb-12 md:mb-16" data-animate>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">The 048 Collection</p>
        <h2 class="text-3xl md:text-5xl font-heading font-bold text-slate-900 mb-5">Find the right rice for your customers.</h2>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed">Six premium Basmati rice variants, each with a clear product promise and an ownable shelf color.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {products.map((product, index) => (
          <a href={`/048-brand/${product.slug}`} class="group block bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 no-underline" data-animate>
            <div class="relative aspect-square overflow-hidden">
              <img src={product.image} alt={`048 ${product.name} Premium ${product.subtext} rice bag`} class="w-full h-full object-cover group-hover:scale-[1.035] transition-transform duration-700" loading="lazy" decoding="async" />
              <div class={`absolute left-4 top-4 ${product.colorClass} text-white text-[10px] uppercase tracking-[0.16em] font-bold px-3 py-2 rounded-full shadow-lg`}>{String(index + 1).padStart(2, "0")} · {product.color}</div>
            </div>
            <div class="p-6 md:p-7">
              <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-gold-500 mb-2">048 Premium Rice</p>
              <h3 class="text-2xl font-heading font-bold text-slate-900 mb-1">{product.name}</h3>
              <p class="text-xs font-semibold uppercase tracking-wider text-forest-700 mb-4">{product.subtext}</p>
              <p class="text-sm text-slate-600 leading-relaxed">{product.description}</p>
              <span class="inline-flex mt-5 text-sm font-bold text-forest-700 group-hover:text-gold-600 transition-colors">View product details →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ GRAIN QUALITY SHOWCASE ═══════════════════ -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div data-animate>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">Real Rice Quality</p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-5">Premium grains you can see and trust.</h2>
          <p class="text-slate-600 leading-relaxed mb-6">Every 048 variant starts with carefully selected Basmati paddy from India's finest rice-growing regions. Multi-pass sortex technology, in-house lab testing and controlled ageing ensure that every bag delivers the premium quality your customers expect.</p>
          <div class="space-y-3 mb-8">
            {[
              "Multi-pass colour sorting for uniform grain appearance",
              "In-house laboratory testing — every batch, every time",
              "Controlled ageing for optimal aroma and elongation",
              "Hygienically packed in nitrogen-flushed environments",
            ].map((point) => (
              <div class="flex items-center gap-3 text-sm text-slate-700">
                <span class="h-2 w-2 rounded-full bg-forest-500"></span>{point}
              </div>
            ))}
          </div>
          <a href="#our-range" class="text-sm font-semibold text-forest-700 hover:text-gold-600 no-underline transition-colors">Explore all six variants →</a>
        </div>
        <div class="grid grid-cols-2 gap-3 md:gap-4" data-animate>
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-lg col-span-2">
            <img src="/images/rice-images/TIBAR.jpeg" alt="048 Tibar Classic premium Basmati rice grains close-up" class="w-full h-48 md:h-64 object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-lg">
            <img src="/images/rice-images/Second wand.jpeg" alt="048 premium Basmati rice grain quality" class="w-full h-40 md:h-48 object-cover" loading="lazy" decoding="async" />
          </div>
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-lg">
            <img src="/images/rice-images/1401-steam-rice-1.png" alt="048 premium long grain Basmati rice" class="w-full h-40 md:h-48 object-cover" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CAMPAIGN BANNERS ═══════════════════ -->
  <section class="section-padding bg-cream">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12" data-animate>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">A Range With Presence</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4">Designed to stand out. Made to be remembered.</h2>
        <p class="text-slate-600">Distinctive packs give buyers an easy way to merchandise a complete Basmati portfolio across consumer needs.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {[
          { src: "/images/Rice Bags/XXXL Supreme banner view image.jpeg", alt: "048 XXXL Supreme Premium Extra Long Basmati campaign" },
          { src: "/images/Rice Bags/Signature XXL banner view image.jpeg", alt: "048 Signature XXL Premium Long Grain Basmati campaign" },
          { src: "/images/Rice Bags/Tibar classic banner view image.jpeg", alt: "048 Tibar Classic premium range campaign" },
          { src: "/images/Rice Bags/Rozana banner view image.jpeg", alt: "048 Rozana Premium Everyday Basmati campaign" },
          { src: "/images/Rice Bags/Dubar Delight Banner view image.jpeg", alt: "048 Dubar Delight Authentic Basmati campaign" },
          { src: "/images/Rice Bags/Mini Dubar Express Banner View Image.jpeg", alt: "048 Mini Dubar Express Quick Cook Basmati campaign" },
        ].map((banner) => (
          <figure class="rounded-3xl overflow-hidden border border-slate-200 shadow-lg" data-animate>
            <img src={banner.src} alt={banner.alt} class="w-full h-full object-cover aspect-[705/520]" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PARTNER VALUE ═══════════════════ -->
  <section class="section-padding bg-forest-950 text-white overflow-hidden">
    <div class="container-custom relative">
      <div class="absolute -right-24 -top-24 w-80 h-80 rounded-full bg-gold-400/10 blur-3xl"></div>
      <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div data-animate>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-300 mb-4">For Importers & Distributors</p>
          <h2 class="text-3xl md:text-5xl font-heading font-bold text-white leading-tight mb-6">A flexible range for serious rice buyers.</h2>
          <p class="text-forest-100/75 leading-relaxed mb-8">Whether you source premium Indian Basmati rice for retail, wholesale, foodservice or regional distribution, 048 gives you six consumer-facing variants under one coherent brand. Speak with our team about market fit, commercial quantities, destination requirements and pack options.</p>
          <a href="#brand-inquiry" class="btn-gold">Discuss your market</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-4" data-animate>
          {[
            { number: "01", title: "Clear segmentation", text: "From extra-long and long-grain to everyday, traditional, authentic and quick-cook choices." },
            { number: "02", title: "Strong shelf identity", text: "Six differentiated colors make the collection easy to navigate and merchandise." },
            { number: "03", title: "Trade-led support", text: "A direct conversation around volumes, destinations, documentation and distribution plans." },
            { number: "04", title: "India + export focus", text: "One partnership route for overseas buyers and domestic distribution enquiries." },
          ].map((item) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
              <p class="text-xs font-bold tracking-widest text-gold-300 mb-5">{item.number}</p>
              <h3 class="text-xl font-heading font-bold text-white mb-2">{item.title}</h3>
              <p class="text-sm text-forest-100/65 leading-relaxed">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <IndiaDistributionMap />

  <!-- ═══════════════════ TARGET MARKETS ═══════════════════ -->
  <section class="section-padding bg-slate-50">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-2" data-animate>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500 mb-4">Global Market Focus</p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-5">Let's build demand in your market.</h2>
          <p class="text-slate-600 leading-relaxed">We welcome 048 brand enquiries from Basmati rice importers, distributors, wholesalers, supermarket buyers and HoReCa partners worldwide, with a dedicated focus on the Gulf, Europe, North America, Africa, Asia-Pacific and India.</p>
        </div>
        <div class="lg:col-span-3 flex flex-wrap gap-3" data-animate>
          {markets.map((market) => (
            <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm"><span class="w-1.5 h-1.5 rounded-full bg-gold-400 mr-2.5"></span>{market}</span>
          ))}
          <p class="w-full mt-3 text-xs text-slate-500">Market names indicate partnership interest, not current availability or exclusivity.</p>
        </div>
      </div>
    </div>
  </section>

  <LeadForm
    formId="brand-inquiry"
    formType="brand"
    heading="Bring 048 to Your Market"
    subtitle="Tell us where you operate, the partnership you are looking for and your expected order volume. Our team will respond with the relevant 048 catalogue and next steps."
  />
</MasterLayout>
