---
/**
 * HeroChimes.astro — Interactive Falling Rice Grain Particles
 * ────────────────────────────────────────────────────────────
 * A canvas-based particle system overlaying the hero section.
 * Golden rice grains drift downward and scatter when the user
 * moves the mouse or touches the screen.
 *
 * "We Make Every Grain Special"
 */
---

<div class="hero-particles" id="hero-particles" aria-hidden="true">
  <canvas class="hp-canvas" id="hp-canvas"></canvas>
</div>

<style>
  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
  }

  .hp-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const canvas = document.getElementById("hp-canvas") as HTMLCanvasElement | null;
  const wrapper = document.getElementById("hero-particles");
  if (!canvas || !wrapper) return;

  const ctx = canvas.getContext("2d");
  if (!ctx) return;

  /* ── Resize ── */
  function resize() {
    const p = canvas!.parentElement!;
    canvas!.width = p.clientWidth;
    canvas!.height = p.clientHeight;
  }
  resize();
  window.addEventListener("resize", resize);

  /* ── Particle ── */
  interface Particle {
    x: number; y: number;
    vx: number; vy: number;
    w: number; h: number;
    rot: number; rotV: number;
    opacity: number;
    hue: number; sat: number; lgt: number;
    life: number; maxLife: number;
  }

  const particles: Particle[] = [];
  const MAX = 55;

  function spawn(): Particle {
    return {
      x: Math.random() * canvas!.width,
      y: -10 - Math.random() * 80,
      vx: (Math.random() - 0.5) * 0.3,
      vy: 0.2 + Math.random() * 0.45,
      w: 2 + Math.random() * 3,
      h: (2 + Math.random() * 3) * (2.5 + Math.random()),
      rot: Math.random() * Math.PI * 2,
      rotV: (Math.random() - 0.5) * 0.02,
      opacity: 0,
      hue: 38 + Math.random() * 14,
      sat: 55 + Math.random() * 35,
      lgt: 75 + Math.random() * 20,
      life: 0,
      maxLife: 500 + Math.random() * 500,
    };
  }

  // Seed
  for (let i = 0; i < MAX; i++) {
    const p = spawn();
    p.y = Math.random() * canvas.height;
    p.life = Math.random() * p.maxLife;
    particles.push(p);
  }

  /* ── Mouse / touch ── */
  let mx = -9999, my = -9999, mActive = false;
  const RADIUS = 130;

  wrapper.style.pointerEvents = "auto";

  wrapper.addEventListener("mousemove", (e) => {
    const r = canvas!.getBoundingClientRect();
    mx = e.clientX - r.left;
    my = e.clientY - r.top;
    mActive = true;
  });
  wrapper.addEventListener("mouseleave", () => { mActive = false; mx = my = -9999; });
  wrapper.addEventListener("touchmove", (e) => {
    const t = e.touches[0], r = canvas!.getBoundingClientRect();
    mx = t.clientX - r.left;
    my = t.clientY - r.top;
    mActive = true;
  }, { passive: true });
  wrapper.addEventListener("touchend", () => { mActive = false; mx = my = -9999; });

  // Click passthrough to CTAs beneath
  wrapper.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest("a") && !t.closest("button")) {
      wrapper.style.pointerEvents = "none";
      const el = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
      if (el && (el.closest("a") || el.closest("button"))) el.click();
      wrapper.style.pointerEvents = "auto";
    }
  });

  /* ── Animation loop ── */
  function animate() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    while (particles.length < MAX) particles.push(spawn());

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.life++;

      // Fade in / out
      const r = p.life / p.maxLife;
      if (r < 0.08) p.opacity = r / 0.08;
      else if (r > 0.88) p.opacity = (1 - r) / 0.12;
      else p.opacity = 0.45 + Math.sin(p.life * 0.015) * 0.1;

      // Mouse / touch scatter
      if (mActive) {
        const dx = p.x - mx, dy = p.y - my;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d < RADIUS && d > 0) {
          const f = (1 - d / RADIUS) * 2.8;
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f * 0.4;
          p.rotV += (Math.random() - 0.5) * 0.05;
        }
      }

      // Physics
      p.vy += 0.004;        // gravity
      p.vx *= 0.988;        // friction
      p.vy *= 0.996;
      p.x += p.vx;
      p.y += p.vy;
      p.rot += p.rotV;
      p.rotV *= 0.996;
      p.vx += Math.sin(p.life * 0.007 + p.y * 0.003) * 0.012; // gentle wind

      // Remove expired / off-screen
      if (p.life >= p.maxLife || p.y > canvas.height + 20 || p.x < -30 || p.x > canvas.width + 30) {
        particles.splice(i, 1);
        continue;
      }

      // Draw rice-grain shaped particle
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.globalAlpha = Math.max(0, Math.min(1, p.opacity));

      const g = ctx.createLinearGradient(-p.w / 2, -p.h / 2, p.w / 2, p.h / 2);
      g.addColorStop(0, `hsla(${p.hue},${p.sat}%,${Math.min(p.lgt + 10, 97)}%,0.9)`);
      g.addColorStop(0.5, `hsla(${p.hue},${p.sat}%,${p.lgt}%,1)`);
      g.addColorStop(1, `hsla(${p.hue},${p.sat - 10}%,${p.lgt - 15}%,0.85)`);
      ctx.fillStyle = g;

      ctx.beginPath();
      ctx.ellipse(0, 0, p.w / 2, p.h / 2, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    requestAnimationFrame(animate);
  }

  requestAnimationFrame(animate);
});
</script>
