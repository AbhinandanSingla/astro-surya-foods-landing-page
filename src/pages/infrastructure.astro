---
import MasterLayout from "../layouts/MasterLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";

const MILLING_STEPS = [
  {
    title: "Pre-Cleaning",
    description: "The first step involves the removal of all large impurities, dust, straw, and unfilled grains from the raw paddy. This ensures only clean paddy moves forward in the milling process, protecting subsequent machinery from damage.",
    image: "https://images.unsplash.com/photo-1615811361523-6bd03d7748e7?w=800&q=80",
    step: 1
  },
  {
    title: "Parboiling (Optional)",
    description: "A crucial step for specific rice varieties. The paddy is soaked and steamed to gelatinize the starch inside the grain. This improves the nutritional quality, hardens the grain to prevent breakage during milling, and locks in the aroma.",
    image: "https://images.unsplash.com/photo-1542838132-92c53300491e?w=800&q=80",
    step: 2
  },
  {
    title: "De-Stoning",
    description: "Using specific gravity and vibration, the De-Stoner machine carefully separates small stones, mud balls, and other heavy impurities from the paddy that the pre-cleaner might have missed.",
    image: "https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=800&q=80",
    step: 3
  },
  {
    title: "Husking",
    description: "The clean paddy is passed through rubber roll huskers. The friction removes the tough outer hull (husk) from the grain, revealing the brown rice underneath.",
    image: "https://images.unsplash.com/photo-1628183182103-68d0034a7065?w=800&q=80",
    step: 4
  },
  {
    title: "Husk Aspiration",
    description: "Once husked, the lighter husk is separated from the heavier brown rice and unhusked paddy using powerful air aspiration systems. The husk is often repurposed as biofuel.",
    image: "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=800&q=80",
    step: 5
  },
  {
    title: "Paddy Separation",
    description: "Since husking is never 100% efficient in a single pass, a Paddy Separator is used. It separates the unhusked paddy from the brown rice, sending the paddy back to the husker for another pass.",
    image: "https://images.unsplash.com/photo-1616423640778-28d1b53229bd?w=800&q=80",
    step: 6
  },
  {
    title: "Whitening",
    description: "The brown rice passes through abrasive whiteners which gently scrape off the outer bran layer and germ, turning the brown rice into white rice.",
    image: "https://images.unsplash.com/photo-1563720223185-11003d516935?w=800&q=80",
    step: 7
  },
  {
    title: "Polishing",
    description: "To improve appearance and shelf life, the whitened rice is passed through silky polishers. Utilizing water mist and friction, this step removes the remaining microscopic bran particles, giving the kernel a brilliant, shiny exterior.",
    image: "https://images.unsplash.com/photo-1605810230434-7631ac76ec81?w=800&q=80",
    step: 8
  },
  {
    title: "Sorting & Grading",
    description: "Advanced optical color sorters use high-speed cameras to identify and eject discolored or chalky grains. Precision length graders then separate the rice into head rice (whole grains) and various sizes of broken rice.",
    image: "https://images.unsplash.com/photo-1589939705384-5185137a7f0f?w=800&q=80",
    step: 9
  },
  {
    title: "Weighing & Bagging",
    description: "The final, flawless rice is automatically weighed and bagged in hygienic, food-grade packaging. The automated system ensures exact weight and airtight sealing before being dispatched to our global customers.",
    image: "https://images.unsplash.com/photo-1605371924599-2d0365da1ae0?w=800&q=80",
    step: 10
  }
];
---

<MasterLayout
  title="Infrastructure & Milling Process | Surya Foods"
  description="Explore Surya Foods' state-of-the-art rice milling infrastructure, from procurement and safe storage to our 10-step advanced processing and cleaning journey."
  transparentNav={true}
>
  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative min-h-[60vh] flex items-center pt-24">
    <img
      src="https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=1600&q=80"
      alt="Modern industrial facility"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-forest-950/95 via-forest-950/80 to-forest-950/40"></div>

    <div class="relative z-10 container-custom py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-gold-400 mb-4 animate-fade-in">
          STATE-OF-THE-ART FACILITY
        </p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-heading font-bold text-white leading-[1.1] mb-6">
          Our Global Standard<br />
          <span class="text-gradient-gold">Infrastructure.</span>
        </h1>
        <p class="text-base md:text-lg text-forest-100/90 leading-relaxed mb-8 max-w-xl">
          With customer delight as our primary aim, we ensure your plate is served with the most aromatic and premium quality rice. Discover the technology and precision behind every grain.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ PROCUREMENT & STORAGE ═══════════════════ -->
  <section class="section-padding bg-cream relative overflow-hidden">
    <div class="container-custom">
      <SectionHeading 
        title="Procurement & Storage"
        subtitle="Sourcing the finest paddy and storing it safely to preserve natural aroma."
        centered={true}
      />
      
      <div class="max-w-4xl mx-auto mt-12 bg-white rounded-3xl shadow-xl p-8 md:p-12 border border-slate-100">
        <div class="prose prose-lg max-w-none text-slate-600">
          <h3 class="text-2xl font-heading font-bold text-forest-900 mb-4">The Procurement Process</h3>
          <p class="mb-8 text-justify">
            Procuring premium rice requires a thorough understanding of the agricultural market and strong relationships with farmers. At Surya Foods, we are associated with a vast network of dedicated farmers who have been cultivating Basmati for generations. Our procurement experts carefully select paddy from the best agricultural belts in India, ensuring that only the finest raw material enters our facility.
          </p>

          <h3 class="text-2xl font-heading font-bold text-forest-900 mb-4">Safe Storage Facilities</h3>
          <p class="mb-6">
            Storage of the paddy is managed at precise moisture levels to ensure the grain ages perfectly without losing its aromatic properties. We utilize three main modes of safe storage:
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 not-prose mt-8">
            <div class="bg-forest-50 p-6 rounded-2xl border border-forest-100">
              <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?w=500&q=80" alt="Silos Storage" class="w-full h-40 object-cover rounded-xl mb-4 shadow-sm" />
              <h4 class="text-lg font-bold text-forest-900 mb-2">Modern Silos</h4>
              <p class="text-sm text-forest-800/80">Temperature-controlled metal silos provide the safest environment against pests and moisture.</p>
            </div>
            <div class="bg-forest-50 p-6 rounded-2xl border border-forest-100">
              <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=500&q=80" alt="Warehouse Storage" class="w-full h-40 object-cover rounded-xl mb-4 shadow-sm" />
              <h4 class="text-lg font-bold text-forest-900 mb-2">Warehouses</h4>
              <p class="text-sm text-forest-800/80">Massive, well-ventilated indoor warehouses for bulk storage of bagged paddy.</p>
            </div>
            <div class="bg-forest-50 p-6 rounded-2xl border border-forest-100">
              <img src="https://images.unsplash.com/photo-1599940824399-b87987ceb72a?w=500&q=80" alt="Open Stack Storage" class="w-full h-40 object-cover rounded-xl mb-4 shadow-sm" />
              <h4 class="text-lg font-bold text-forest-900 mb-2">Open Stacks</h4>
              <p class="text-sm text-forest-800/80">Secure open-air stacking methods protected by specialized waterproof and breathable covers.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ MILLING PROCESS ═══════════════════ -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <SectionHeading 
        title="Processing & Milling Journey"
        subtitle="Rice in its natural form is inedible. Follow our 10-step advanced milling process to see how we transform raw paddy into the world's finest rice."
        centered={true}
      />

      <div class="mt-16 max-w-5xl mx-auto relative">
        <!-- Vertical Line for Desktop -->
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-gold-200/50 -translate-x-1/2"></div>
        
        <div class="space-y-12 md:space-y-24">
          {MILLING_STEPS.map((step, index) => (
            <div class={`relative flex flex-col md:flex-row items-center gap-8 md:gap-16 ${index % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
              
              <!-- Number Badge (Desktop) -->
              <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-forest-900 text-gold-400 font-heading font-bold text-xl items-center justify-center border-4 border-white z-10 shadow-md">
                {step.step}
              </div>
              
              <!-- Image -->
              <div class="w-full md:w-1/2 relative group">
                <!-- Number Badge (Mobile) -->
                <div class="md:hidden absolute -top-4 -left-4 w-10 h-10 rounded-full bg-forest-900 text-gold-400 font-heading font-bold text-lg flex items-center justify-center border-4 border-white z-10 shadow-md">
                  {step.step}
                </div>
                
                <div class="rounded-2xl overflow-hidden shadow-lg border border-slate-100">
                  <img 
                    src={step.image} 
                    alt={step.title} 
                    class="w-full h-64 md:h-80 object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                </div>
              </div>
              
              <!-- Content -->
              <div class={`w-full md:w-1/2 ${index % 2 === 0 ? 'md:pl-8' : 'md:pr-8 text-left md:text-right'}`}>
                <h3 class="text-2xl md:text-3xl font-heading font-bold text-forest-900 mb-4">{step.title}</h3>
                <p class="text-base text-slate-600 leading-relaxed">
                  {step.description}
                </p>
              </div>
              
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ CTA ═══════════════════ -->
  <section class="section-padding bg-forest-950 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    <div class="relative container-custom text-center max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-6">
        Experience Premium Quality
      </h2>
      <p class="text-forest-200/80 mb-10 text-lg">
        Our infrastructure ensures that every bag of Surya Foods rice meets rigorous international standards. 
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/products" class="btn-gold">
          Explore Our Products
        </a>
        <a href="/quality-control" class="btn-secondary">
          View Quality Standards
        </a>
      </div>
    </div>
  </section>
</MasterLayout>
