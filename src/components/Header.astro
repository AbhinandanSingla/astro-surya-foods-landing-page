---
import NavLink from "./NavLink.astro";
import { NAV_LINKS, TRUST_BAR_TEXT, PHONE_NUMBER, EMAIL, WHATSAPP_NUMBER, LANGUAGES } from "../consts";

interface Props {
  transparentNav?: boolean;
}

const { transparentNav = false } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50">
  <!-- Contact Bar (topmost) -->
  <div class="bg-forest-950 border-b border-forest-800/50 hidden md:block">
    <div class="container-custom flex items-center justify-between py-1.5">
      <!-- Left: Contact info -->
      <div class="flex items-center gap-5">
        <a href={`tel:${PHONE_NUMBER}`} class="flex items-center gap-1.5 text-[11px] text-forest-200/80 hover:text-gold-400 transition-colors no-underline">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          +91-9779204835
        </a>
        <a href={`mailto:${EMAIL}`} class="flex items-center gap-1.5 text-[11px] text-forest-200/80 hover:text-gold-400 transition-colors no-underline">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          {EMAIL}
        </a>
        <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-[11px] text-forest-200/80 hover:text-green-400 transition-colors no-underline">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
      <!-- Center: Trust text -->
      <p class="text-[10px] font-medium tracking-[0.12em] uppercase text-forest-200/60 m-0">
        {TRUST_BAR_TEXT}
      </p>
      <!-- Right: Language picker -->
      <div class="relative" id="lang-picker-wrapper">
        <button
          id="lang-picker-btn"
          class="flex items-center gap-1.5 text-[11px] text-forest-200/80 hover:text-gold-400 transition-colors cursor-pointer bg-transparent border border-forest-700/40 rounded px-2.5 py-1"
          aria-label="Select language"
          aria-expanded="false"
        >
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span id="lang-current">English</span>
          <svg class="w-2.5 h-2.5 transition-transform" id="lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <div id="lang-dropdown" class="absolute right-0 top-full mt-1 bg-forest-900 border border-forest-700/50 rounded-lg shadow-xl py-1 min-w-[140px] hidden z-50">
          {LANGUAGES.map((lang) => (
            <button
              class="w-full text-left flex items-center gap-2 px-3 py-2 text-[11px] text-forest-200/80 hover:bg-forest-800 hover:text-gold-400 transition-colors cursor-pointer bg-transparent border-none"
              data-lang={lang.code}
            >
              <span class="text-sm">{lang.flag}</span>
              {lang.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <nav
    id="main-nav"
    class:list={[
      "transition-all duration-300",
      transparentNav
        ? "bg-transparent border-b border-transparent"
        : "bg-forest-900/95 backdrop-blur-md border-b border-forest-700/30 shadow-lg",
    ]}
    data-transparent={transparentNav ? "true" : "false"}
  >
    <div class="container-custom flex items-center justify-between py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-decoration-none group">
        <span class="text-xl md:text-2xl font-heading font-bold text-white tracking-wide">
          SURYA<span class="text-gold-400">FOODS</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-6">
        {NAV_LINKS.map((link) => (
          'megaMenu' in link ? (
            <!-- Mega Menu for Products -->
            <div class="relative group">
              <button class="flex items-center gap-1 px-1 py-2 text-sm font-medium tracking-wide text-white/80 hover:text-gold-300 transition-colors duration-300 cursor-pointer bg-transparent border-none">
                {link.label}
                <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                <div class="bg-forest-900 border border-forest-700/50 rounded-xl shadow-2xl p-6 w-[850px] max-h-[70vh] overflow-y-auto custom-scrollbar">
                  <div class="grid grid-cols-4 gap-6">
                    {link.items.map((category) => (
                      <div>
                        <a href={category.href} class="block text-xs font-bold uppercase tracking-widest text-gold-400 mb-4 no-underline hover:text-gold-300 transition-colors border-b border-forest-700/50 pb-2">
                          {category.label}
                        </a>
                        <div class="space-y-4">
                          {'children' in category && category.children.map((child) => (
                            'subChildren' in child ? (
                              <div class="space-y-1.5">
                                <span class="block px-1 text-[13px] font-semibold text-white/90">
                                  {child.label}
                                </span>
                                <div class="pl-2 border-l-2 border-forest-800 space-y-1">
                                  {child.subChildren.map((subChild) => (
                                    <a href={subChild.href} class="block px-2 py-1 text-[12px] text-forest-200/70 hover:bg-forest-800 hover:text-gold-400 rounded transition-colors no-underline">
                                      {subChild.label}
                                    </a>
                                  ))}
                                </div>
                              </div>
                            ) : (
                              <a href={child.href} class="block px-1 py-1.5 text-[13px] text-forest-200/70 hover:bg-forest-800 hover:text-gold-400 rounded transition-colors no-underline">
                                {child.label}
                              </a>
                            )
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                  <div class="mt-5 pt-4 border-t border-forest-700/40">
                    <a href="/products" class="text-sm text-gold-400 hover:text-gold-300 no-underline font-semibold inline-flex items-center gap-2 transition-colors">
                      View All Products
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ) : 'items' in link ? (
            <!-- Regular Dropdown -->
            <div class="relative group">
              <button class="flex items-center gap-1 px-1 py-2 text-sm font-medium tracking-wide text-white/80 hover:text-gold-300 transition-colors duration-300 cursor-pointer bg-transparent border-none">
                {link.label}
                <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                <div class="bg-forest-900 border border-forest-700/50 rounded-lg shadow-xl py-2">
                  {link.items.map((subItem) => (
                    <a href={subItem.href} class="block px-4 py-2 text-sm text-forest-200/80 hover:bg-forest-800 hover:text-gold-400 transition-colors no-underline">
                      {subItem.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <NavLink href={link.href}>{link.label}</NavLink>
          )
        ))}
        <a href="/global-exports#inquiry-form" class="btn-primary !py-2.5 !px-6 !text-xs">
          Partner With Us
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="menu-toggle"
        class="lg:hidden flex flex-col gap-1.5 p-2 cursor-pointer bg-transparent border-none"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300 origin-center" id="bar-1"></span>
        <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300" id="bar-2"></span>
        <span class="block w-6 h-0.5 bg-white rounded-full transition-all duration-300 origin-center" id="bar-3"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="fixed inset-0 top-0 z-[100] bg-forest-950/98 backdrop-blur-xl transform translate-x-full transition-transform duration-500 ease-in-out lg:hidden"
  >
    <div class="flex flex-col h-full">
      <div class="flex items-center justify-between px-6 py-5">
        <span class="text-xl font-heading font-bold text-white tracking-wide">
          SURYA<span class="text-gold-400">FOODS</span>
        </span>
        <button
          id="menu-close"
          class="p-2 cursor-pointer bg-transparent border-none"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <!-- Mobile contact info -->
      <div class="flex items-center justify-center gap-4 px-6 py-3 border-b border-forest-800/50">
        <a href={`tel:${PHONE_NUMBER}`} class="text-xs text-forest-300 hover:text-gold-400 transition-colors no-underline flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Call
        </a>
        <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="text-xs text-forest-300 hover:text-green-400 transition-colors no-underline flex items-center gap-1">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a href={`mailto:${EMAIL}`} class="text-xs text-forest-300 hover:text-gold-400 transition-colors no-underline flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Email
        </a>
      </div>
      <nav class="flex flex-col items-center justify-start flex-1 gap-6 overflow-y-auto max-h-[70vh] py-8 custom-scrollbar w-full">
        {NAV_LINKS.map((link) => (
          'megaMenu' in link ? (
            <div class="flex flex-col items-center gap-4 w-full px-4">
              <a href="/products" class="text-2xl font-heading font-semibold text-white/90 hover:text-gold-400 transition-colors no-underline">
                {link.label}
              </a>
              <div class="flex flex-col items-center gap-6 mt-2 w-full">
                {link.items.map((category) => (
                  <div class="flex flex-col items-center w-full">
                    <a href={category.href} class="text-lg font-heading font-bold text-gold-400 mb-2 hover:text-gold-300 transition-colors duration-300 no-underline text-center">
                      {category.label}
                    </a>
                    <div class="flex flex-col items-center gap-3">
                      {'children' in category && category.children.map((child) => (
                        'subChildren' in child ? (
                          <div class="flex flex-col items-center text-center">
                            <span class="text-base font-semibold text-white/80 mb-1">
                              {child.label}
                            </span>
                            <div class="flex flex-wrap justify-center gap-2">
                              {child.subChildren.map((subChild) => (
                                <a href={subChild.href} class="text-sm text-forest-200/70 hover:text-gold-400 transition-colors no-underline bg-forest-800/50 px-3 py-1 rounded-full">
                                  {subChild.label}
                                </a>
                              ))}
                            </div>
                          </div>
                        ) : (
                          <a href={child.href} class="text-base text-forest-200/70 hover:text-gold-400 transition-colors no-underline">
                            {child.label}
                          </a>
                        )
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ) : 'items' in link ? (
            <div class="flex flex-col items-center gap-3 w-full">
              <span class="text-2xl font-heading font-semibold text-white/90">
                {link.label}
              </span>
              <div class="flex flex-col items-center gap-2 mt-1">
                {link.items.map((subItem) => (
                  <a href={subItem.href} class="text-base font-heading font-medium text-forest-200/70 hover:text-gold-400 transition-colors duration-300 no-underline">
                    {subItem.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="text-2xl font-heading font-semibold text-white/90 hover:text-gold-400 transition-colors duration-300 no-underline"
            >
              {link.label}
            </a>
          )
        ))}
        <a href="/global-exports#inquiry-form" class="btn-gold mt-4">
          Partner With Us
        </a>
      </nav>
    </div>
  </div>
</header>

<!-- Spacer to prevent content from being hidden behind fixed header -->
<div class:list={[transparentNav ? "" : "h-[88px] sm:h-[120px]"]}></div>

<script>
  // Scroll-aware nav
  const nav = document.getElementById("main-nav");
  const isTransparent = nav?.getAttribute("data-transparent") === "true";

  if (isTransparent && nav) {
    const handleScroll = () => {
      if (window.scrollY > 60) {
        nav.classList.add("bg-forest-900/95", "backdrop-blur-md", "border-forest-700/30", "shadow-lg");
        nav.classList.remove("bg-transparent", "border-transparent");
      } else {
        nav.classList.remove("bg-forest-900/95", "backdrop-blur-md", "border-forest-700/30", "shadow-lg");
        nav.classList.add("bg-transparent", "border-transparent");
      }
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }

  // Mobile menu toggle
  const menuToggle = document.getElementById("menu-toggle");
  const menuClose = document.getElementById("menu-close");
  const mobileMenu = document.getElementById("mobile-menu");

  function openMenu() {
    mobileMenu?.classList.remove("translate-x-full");
    mobileMenu?.classList.add("translate-x-0");
    document.body.style.overflow = "hidden";
    menuToggle?.setAttribute("aria-expanded", "true");
  }

  function closeMenu() {
    mobileMenu?.classList.add("translate-x-full");
    mobileMenu?.classList.remove("translate-x-0");
    document.body.style.overflow = "";
    menuToggle?.setAttribute("aria-expanded", "false");
  }

  menuToggle?.addEventListener("click", openMenu);
  menuClose?.addEventListener("click", closeMenu);

  // Close menu on link click
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Close on escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  // Language picker
  const langBtn = document.getElementById("lang-picker-btn");
  const langDropdown = document.getElementById("lang-dropdown");
  const langChevron = document.getElementById("lang-chevron");
  const langCurrent = document.getElementById("lang-current");

  langBtn?.addEventListener("click", () => {
    const isOpen = !langDropdown?.classList.contains("hidden");
    if (isOpen) {
      langDropdown?.classList.add("hidden");
      langChevron?.classList.remove("rotate-180");
      langBtn?.setAttribute("aria-expanded", "false");
    } else {
      langDropdown?.classList.remove("hidden");
      langChevron?.classList.add("rotate-180");
      langBtn?.setAttribute("aria-expanded", "true");
    }
  });

  langDropdown?.querySelectorAll("button[data-lang]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const label = btn.textContent?.trim().split("\n").pop()?.trim();
      if (langCurrent && label) langCurrent.textContent = label;
      langDropdown?.classList.add("hidden");
      langChevron?.classList.remove("rotate-180");
      langBtn?.setAttribute("aria-expanded", "false");
    });
  });

  // Close on outside click
  document.addEventListener("click", (e) => {
    const wrapper = document.getElementById("lang-picker-wrapper");
    if (wrapper && !wrapper.contains(e.target as Node)) {
      langDropdown?.classList.add("hidden");
      langChevron?.classList.remove("rotate-180");
      langBtn?.setAttribute("aria-expanded", "false");
    }
  });
</script>
